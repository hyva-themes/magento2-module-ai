declare(strict_types=1);

use Hyva\Ai\Block\Adminhtml\System\Config\ProviderOptions;
use Magento\Framework\Escaper;

/**
 * @var ProviderOptions $block
 * @var Escaper $escaper
 */

$elementId = $block->getHtmlId();
?>
<textarea hidden id="<?= $escaper->escapeHtmlAttr($elementId) ?>"
    name="<?= $escaper->escapeHtmlAttr($block->getElement()->getName()) ?>"
    <?= /** @noEscape */ $block->getElement()->getDisabled() ? 'disabled' : '' ?>
><?= $escaper->escapeHtml($block->getValueAsJson()) ?></textarea>
<div id="<?= $escaper->escapeHtmlAttr($elementId) ?>_container" class="hyva-ai-options"></div>
<script>
require(['Hyva_Ai/js/model-picker', 'domReady!'], function (init) {
    init({
        elementId: <?= /** @noEscape */ json_encode($elementId, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        modelFieldId: <?= /** @noEscape */ json_encode($block->getModelFieldId(), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        picker: <?= /** @noEscape */ $block->getPickerJson() ?>
    });
});
</script>
