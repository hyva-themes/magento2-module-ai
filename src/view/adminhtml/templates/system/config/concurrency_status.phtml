declare(strict_types=1);

use Hyva\Ai\Block\Adminhtml\System\Config\ConcurrencyStatusField;
use Magento\Framework\Escaper;

/**
 * @var ConcurrencyStatusField $block
 * @var Escaper $escaper
 */

$activeCount = $block->getActiveLockCount();
$maxSlots    = $block->getMaxSlots();
$backendLabel = $block->getLockBackendLabel();
$docsUrl     = $block->getLockProviderDocsUrl();
?>
<p class="note" style="margin-top: 0.5em;">
    <?= $escaper->escapeHtml(__('%1 of %2 slot(s) currently in use.', $activeCount, $maxSlots)) ?>
    <?php if ($maxSlots === 0): ?>
        <?= $escaper->escapeHtml(__('(disabled)')) ?>
    <?php endif; ?>
</p>
